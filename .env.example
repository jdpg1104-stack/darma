# ============================================================================
# Darma · plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y NUNCA debe versionarse.
#
# Regla de oro: todo lo que empieza por NEXT_PUBLIC_ acaba EN EL NAVEGADOR, en
# texto plano, visible para cualquiera que abra las herramientas de desarrollo.
# Si un valor no puede verse, no lleva ese prefijo. No hay excepciones.
# ============================================================================

# ── Supabase · público (viaja al navegador) ─────────────────────────────────
# La URL del proyecto también alimenta la CSP: next.config.ts deriva de aquí el
# origen que se permite en connect-src e img-src. Si está mal, el navegador
# bloquea las llamadas a Supabase sin dar un error obvio.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# La anon key es pública POR DISEÑO: no otorga permisos por sí misma, solo
# identifica al proyecto. Quien la tenga puede hablar con PostgREST — y ahí es
# donde RLS decide qué ve y qué escribe. Por eso el esquema deniega por defecto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Supabase · SECRETO (solo servidor) ──────────────────────────────────────
# ⚠️ La service_role key SALTA TODAS LAS POLÍTICAS RLS, incluida la ausencia
# deliberada de políticas sobre identity_vault. Es la única llave del sistema que
# puede vincular un seudónimo con una persona real. Nunca la pongas tras
# NEXT_PUBLIC_, nunca la importes desde un componente de cliente, nunca la pegues
# en un canal de chat. Si se filtra, se rota de inmediato.
SUPABASE_SERVICE_ROLE_KEY=

# Pimienta del hash de contacto que guarda identity_vault. Permite detectar
# multicuenta sin almacenar el email en claro. Rotarla invalida las detecciones
# anteriores, así que se trata como un secreto permanente.
#
# Se llama PEPPER y no SALT a propósito: una sal se guarda junto al hash y solo
# impide precomputar tablas; esto vive solo en el entorno, así que quien robe la
# base de datos entera sigue sin poder probar si un email concreto está dentro.
# Esa diferencia es justo lo que protege el anonimato de Darma.
# Generar con: openssl rand -hex 32
IDENTITY_PEPPER=

# Clave de cifrado (AES-256-GCM) de los secretos TOTP del segundo factor. Se
# guarda cifrado en la base: si alguien se lleva la tabla, sin esta clave no
# puede generar los códigos de nadie.
# Generar con: openssl rand -hex 32
TOTP_ENC_KEY=

# ── Crons de Vercel ─────────────────────────────────────────────────────────
# Las rutas /api/cron/* son públicas en el proxy (llegan sin sesión, desde una
# máquina) y se autentican ELLAS MISMAS comparando este secreto con la cabecera
# `Authorization: Bearer <CRON_SECRET>`. Sin él, cualquiera dispararía la
# ingesta de contenido.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Moderación y seguridad ──────────────────────────────────────────────────
# Proveedor de clasificación de riesgo/calidad. Sin esta clave, ningún
# comentario se valida (is_validated) y, por tanto, no se acredita reciprocidad:
# el sistema falla CERRADO, que es lo correcto.
MODERATION_API_KEY=

# Rate limiting distribuido (segunda capa; la primera es en memoria por
# instancia). Opcional en local: sin estas variables solo actúa la capa local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Entorno ─────────────────────────────────────────────────────────────────
# URL canónica del despliegue. Se usa en metadatos, enlaces absolutos de correo
# y callbacks de autenticación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
