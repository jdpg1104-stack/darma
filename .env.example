# ============================================================================
# Darma · plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` está en
# .gitignore y NUNCA debe versionarse.
#
# Regla de oro: todo lo que empieza por NEXT_PUBLIC_ acaba EN EL NAVEGADOR, en
# texto plano, visible para cualquiera que abra las herramientas de desarrollo.
# Si un valor no puede verse, no lleva ese prefijo. No hay excepciones.
# ============================================================================

# ── Supabase · público (viaja al navegador) ─────────────────────────────────
# La URL del proyecto también alimenta la CSP: next.config.ts deriva de aquí el
# origen que se permite en connect-src e img-src. Si está mal, el navegador
# bloquea las llamadas a Supabase sin dar un error obvio.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# La anon key es pública POR DISEÑO: no otorga permisos por sí misma, solo
# identifica al proyecto. Quien la tenga puede hablar con PostgREST — y ahí es
# donde RLS decide qué ve y qué escribe. Por eso el esquema deniega por defecto.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Supabase · SECRETO (solo servidor) ──────────────────────────────────────
# ⚠️ La service_role key SALTA TODAS LAS POLÍTICAS RLS, incluida la ausencia
# deliberada de políticas sobre identity_vault. Es la única llave del sistema que
# puede vincular un seudónimo con una persona real. Nunca la pongas tras
# NEXT_PUBLIC_, nunca la importes desde un componente de cliente, nunca la pegues
# en un canal de chat. Si se filtra, se rota de inmediato.
SUPABASE_SERVICE_ROLE_KEY=

# Pimienta del hash de contacto que guarda identity_vault. Permite detectar
# multicuenta sin almacenar el email en claro. Rotarla invalida las detecciones
# anteriores, así que se trata como un secreto permanente.
#
# Se llama PEPPER y no SALT a propósito: una sal se guarda junto al hash y solo
# impide precomputar tablas; esto vive solo en el entorno, así que quien robe la
# base de datos entera sigue sin poder probar si un email concreto está dentro.
# Esa diferencia es justo lo que protege el anonimato de Darma.
# Generar con: openssl rand -hex 32
IDENTITY_PEPPER=

# Clave de cifrado (AES-256-GCM) de los secretos TOTP del segundo factor. Se
# guarda cifrado en la base: si alguien se lleva la tabla, sin esta clave no
# puede generar los códigos de nadie.
# Generar con: openssl rand -hex 32
TOTP_ENC_KEY=

# ── Crons de Vercel ─────────────────────────────────────────────────────────
# Las rutas /api/cron/* son públicas en el proxy (llegan sin sesión, desde una
# máquina) y se autentican ELLAS MISMAS comparando este secreto con la cabecera
# `Authorization: Bearer <CRON_SECRET>`. Sin él, cualquiera dispararía la
# ingesta de contenido.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# ── Moderación y seguridad ──────────────────────────────────────────────────
# Proveedor de clasificación de riesgo/calidad.
#
# ⚠️ CORREGIDO 2026-08-04, verificado contra Postgres: este comentario decía que
# sin la clave «ningún comentario se valida y no se acredita reciprocidad». Es
# FALSO. `validadorPorDefecto` (app/api/comments/validador.ts) es el
# `ValidadorHeuristico`, determinista y sin red, puesto ahí como SUELO a
# propósito — la validación decide si alguien cobra su escucha y no puede
# depender de que un proveedor esté en pie. Medido: un comentario sincero se
# valida solo, `is_validated = true`, +10 de reputación y +1 crédito.
#
# Lo que SÍ se pierde sin la clave: el juicio del modelo por encima de la
# heurística — se cuela relleno que él habría rechazado, y la detección de
# crisis pierde el matiz que solo da leer el texto.
MODERATION_API_KEY=

# Endpoint del proveedor HTTP de curación de contenido (lib/ingest/seguridad.ts):
# POST JSON con `Authorization: Bearer <MODERATION_API_KEY>`. Sin URL o sin
# clave, el proveedor devuelve null y el ítem queda 'incierto' — nunca aprobado
# por defecto.
MODERATION_API_URL=

# Id EXACTO del modelo de clasificación (lib/ai/modelo.ts). Existe para cambiar
# de tier sin desplegar. Vacío = el valor por defecto del código.
MODERATION_MODEL=

# Presupuesto diario del clasificador, en dólares (lib/ai/modelo.ts). Vacío o
# inválido = 600 $/día. El cortacircuitos de lib/ai/presupuesto.ts corta ANTES
# de superarlo.
MODERATION_BUDGET_USD_DAY=

# YouTube Data API v3. La consumen lib/ingest/{descubrir,idiomaAudio,canalesPermitidos}.ts.
#
# Sin ella el descubrimiento por API devuelve vacío con motivo y NO rompe nada:
# la ingesta por feed Atom (RSS) sigue funcionando. Lo que se pierde es buscar
# más allá de los ~15 últimos ítems de cada fuente, la guarda de idioma de audio
# y la verificación de identidad de canal.
#
# 🔴 CUOTA: 10.000 unidades/día. `playlistItems.list` y `videos.list` cuestan 1;
# `search.list` cuesta 100. En DataLaps, usar `search.list` para el frente de
# canales agotó la cuota diaria con un 429 real (2026-07-29). Por eso
# lib/ingest/cuota.ts lleva presupuesto y corta ANTES de agotarla.
YOUTUBE_API_KEY=

# ── Notificaciones push (Web Push · VAPID) ──────────────────────────────────
# Par de claves VAPID (lib/push/vapid.ts). Sin las DOS, el despacho de push
# queda apagado y /api/push/subscribe no guarda suscripciones: una suscripción
# firmada contra otra clave no serviría de nada.
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contacto (mailto: o URL) que viaja en el JWT VAPID para que el servicio de
# push pueda avisar de abusos. Opcional: el código trae un valor por defecto.
VAPID_SUBJECT=

# La MISMA clave pública, expuesta al navegador para crear la suscripción. Es
# la única del bloque que PUEDE llevar NEXT_PUBLIC_: es la mitad pública del
# par. Si falta, el servidor usa VAPID_PUBLIC_KEY como respaldo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Sal del HMAC con el que /api/push/subscribe huella el user-agent (nunca se
# guarda en claro). Sin sal NO se hashea con sal vacía: se guarda null, porque
# «sin sal» tiene que significar «sin dato», no «dato débil».
# Generar con: openssl rand -hex 32
PUSH_UA_SALT=

# ── Observabilidad ──────────────────────────────────────────────────────────
# Bearer de /api/metrics (texto Prometheus). Sin token válido: 401 con cuerpo
# VACÍO — los nombres de métrica ya cuentan el volumen de la red y el tamaño de
# la cola de moderación, que es justo lo que este token protege.
# Generar con: openssl rand -hex 32
METRICS_TOKEN=

# ── Administración · arranque ───────────────────────────────────────────────
# Uuid(s) de `public.profiles` (coma o espacio) que recibirán el PRIMER rol de
# superadmin. SOLO lo lee scripts/security/sembrarSuperadmin.ts, un script que
# se ejecuta A MANO una vez. No autoriza nada en runtime: quién es admin lo
# decide `public.admin_roles` vía `tiene_rol_admin()`, auditable y revocable.
SUPERADMIN_SEED_IDS=

# ── Compras dentro de la app (IAP) ──────────────────────────────────────────
# Verificación de recibos de Apple (lib/billing/apple.ts). FAIL-CLOSED: si
# falta cualquiera, no se verifica ningún recibo — nunca «aceptar todo».
# Ninguna lleva NEXT_PUBLIC_.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# PEM con los saltos de línea escapados como \n (el código los restaura).
APPLE_IAP_PRIVATE_KEY=
APPLE_BUNDLE_ID=
# Huellas SHA-256 de la CA raíz de Apple, separadas por comas.
APPLE_ROOT_CA_SHA256=
# `Sandbox` para el entorno de pruebas; cualquier otro valor cuenta como
# Production.
APPLE_IAP_ENTORNO=

# Verificación de recibos de Google Play (lib/billing/google.ts). Igual de
# fail-closed que Apple.
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_CLIENT_EMAIL=
# PEM con los saltos de línea escapados como \n (el código los restaura).
GOOGLE_PLAY_PRIVATE_KEY=
# Cuenta de servicio autorizada a publicar en el topic de Pub/Sub (RTDN).
GOOGLE_PUBSUB_SERVICE_ACCOUNT=
# Audiencia OIDC configurada en la suscripción push de Pub/Sub.
GOOGLE_PUBSUB_AUDIENCE=

# ── Solo desarrollo y pruebas (no van a Vercel) ─────────────────────────────
# Fusible anti-producción de los e2e (e2e/utils/admin.ts): el ref del proyecto
# Supabase de PRUEBAS. Playwright se niega a arrancar si NEXT_PUBLIC_SUPABASE_URL
# no apunta exactamente a este ref — es lo que impide que una limpieza de datos
# de test toque el proyecto real.
E2E_SUPABASE_PROJECT_REF=

# Puerto del servidor que levanta Playwright (por defecto 3018: B18 es el único
# autorizado a levantar el dev server del árbol compartido, y lo hace ahí para
# no chocar con el 3000 de nadie). Solo hace falta declararlo para correr dos
# suites a la vez o si el 3018 está ocupado.
# E2E_PORT=3018

# Stub del reproductor para la suite E2E (lib/video/stubE2E.ts): el widget de
# youtube-nocookie no emite eventos en headless. ⚠️ NO la pongas aquí ni en
# .env.local: la declara SOLO el webServer de playwright.config.ts, para que la
# vea únicamente el servidor de la suite. Puesta en un build de producción no
# activa nada (el fusible exige además hostname local y el guard
# scripts/security/guardStubReproductor.ts vigila sus cerrojos), pero declararla
# fuera de Playwright es siempre un error.
# NEXT_PUBLIC_E2E_STUB_PLAYER=1

# Token de la cabecera `x-darma-load-test` para las pruebas de carga con k6
# (scripts/load). ⚠️ NUNCA en producción: existe para saltarse el rate limit en
# el entorno de carga, y la app solo lo honra si la variable está presente en
# SU entorno. En producción la variable no debe existir, ni con valor vacío.
LOAD_TEST_TOKEN=

# ── Entorno ─────────────────────────────────────────────────────────────────
# URL canónica del despliegue. Se usa en metadatos, enlaces absolutos de correo
# y callbacks de autenticación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
